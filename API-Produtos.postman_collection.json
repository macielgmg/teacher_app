        "body": {
          "mode": "raw",
          "raw": "{\n  \"avaliacao\": 4.6\n}"
        },
        "url": { "raw": "{{baseUrl}}/produtos/PRD-003", "host": ["{{baseUrl}}"], "path": ["produtos", "PRD-003"] }
