{
  "info": {
    "name": "API Produtos - Gabriel Maciel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "codigoPessoa", "value": "1528156" }
  ],
  "item": [
    {
      "name": "1. POST - Cadastrar produto (código de pessoa)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Mouse Gamer RGB\",\n  \"codigo\": \"{{codigoPessoa}}\",\n  \"preco\": 129.90,\n  \"descricao\": \"Mouse gamer com 7 botões e 12000 DPI\",\n  \"quantidadeEstoque\": 30,\n  \"avaliacao\": 4.7,\n  \"categoria\": \"Periféricos\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
      }
    },
    {
      "name": "2. POST - Cadastrar produto PRD-002",
      "request": {
        "method": "POST",
