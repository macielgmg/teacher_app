          "mode": "raw",
          "raw": "{\n  \"nome\": \"Headset GX 1528\",\n  \"codigo\": \"PRD-002\",\n  \"preco\": 173.45,\n  \"descricao\": \"Headset com microfone para o setup do Gabriel Maciel\",\n  \"quantidadeEstoque\": 12,\n  \"avaliacao\": 4.3,\n  \"categoria\": \"Periféricos\"\n}"
